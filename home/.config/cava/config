## ~/.config/cava/config
## cava 1.0.0 (Arch extra) | Catppuccin Mocha | Samsung Odyssey G5 34" (3440x1440, 21:9, 165 Hz)
##
## Kiem tra da doi chieu voi source cava 1.0.0 (config.c, cava.c, cavacore.c).
## live-config = 1: sua file nay -> cava tu nap lai, khong can restart.
## Nap tay neu can:  pkill -USR1 cava  (toan bo config)  |  pkill -USR2 cava  (chi mau)

[general]

live-config = 1

# Khop tan so quet cua G5 (165 Hz qua DisplayPort). Doi dung so Hz dang chay:
#     wlr-randr | grep -i current
# Smoothing cua cavacore tu bu theo framerate (framerate_mod = 66 / framerate),
# nen tang fps chi lam chuyen dong muot hon, khong doi "cam giac" roi/nay cua cot.
# Terminal ganh khong noi thi ha xuong 120 — nhin van giong, chi bot muot.
framerate = 165

autosens = 1
sensitivity = 100

# bars = 0 -> tu lap day theo be ngang terminal.
# KHONG dat so bars co dinh: cava 1.0.0 thoat han ("window is too narrow for
# number of bars set") khi Wayfire tile cua so hep lai, va voi cua so rong thi
# no chi can giua chu khong keo gian cot.
#
# Ultrawide = rat nhieu cot ky tu. Mac dinh 2/1 tren ~400 cot -> ~130 cot song,
# qua day: vung bass chi co vai bin FFT nen cac cot thap nhat thanh bac thang
# trung nhau, va upstream noi linear scaling dep nhat duoi ~100 cot.
# 3/1 cho ~85-105 cot khi full man hinh (tuy co chu), ~45 khi tile nua man hinh.
#     so cot = (tput cols + 1) / 4
bars = 0
bar_width = 3
bar_spacing = 1

# Can giua -> cot bass (giua man hinh o che do stereo) nam dung tam duong cong 1000R.
center_align = 1
max_height = 100

# Mo rong hon mac dinh (50 / 10000): man rong du cho de khong bop vung mid,
# va 40 Hz de thay ro low-shelf khi ban them bass cho DT 900 Pro X.
lower_cutoff_freq = 40
higher_cutoff_freq = 12000

# Im lang 30 s -> ngung FFT va ve, chi kiem tra input moi giay. Tiet kiem CPU
# khi chay 165 fps. Tinh day cham toi da ~1 s.
sleep_timer = 30


[input]

# 'auto' = monitor cua default sink. Default sink cua ban la JM6 (phan cung),
# EasyEffects xuat vao do -> cava thay tin hieu SAU EQ.
method = pipewire
source = auto


[output]

method = noncurses
orientation = bottom

# Stereo: bass o giua, treble ra hai mep, doi xung (da do: 60 Hz sang cot sat
# tam, 8 kHz sang cot sat mep). Tren man 21:9 cong, tam man la cho mat nhin —
# nen [eq] o cuoi file nang bass len de vung giua khong bi "chet".
channels = stereo
reverse = 0

# Bo chong nhap nhay (DEC mode 2026). Terminal khong ho tro thi thuong bo qua
# chuoi nay; thay rac tren man hinh thi dat 0.
synchronized_sync = 1

show_idle_bar_heads = 1
xaxis = none

# Thu kieu khac tren man rong: cot moc len va xuong tu duong giua.
; orientation = horizontal


[color]

# Mau nam o file theme rieng: ~/.config/cava/themes/<ten>
#   catppuccin-mocha           gradient doc chinh thuc cua catppuccin/cava
#   catppuccin-mocha-spectrum  mau theo tan so, doi xung cho stereo
# Doi dong duoi day -> live-config tu nap.
theme = 'catppuccin-mocha'


[smoothing]

# Monstercat: moi cot keo cot lan can len theo he so 1.5^khoang_cach -> dinh
# thanh doi mem thay vi rang cua. Gia tri < ~0.7 lam he so < 1 -> sai, dung duoi 1.
monstercat = 1
waves = 0

# 0 = nhanh/nhieu, 100 = cham/muot. 77 la mac dinh upstream.
noise_reduction = 77


[eq]

# TAI SAO CO KHOI NAY:
# cava 1.0.0 (linear scaling) nhan moi cot voi he so ti le thuan tan so. Do
# tren chinh binary 1.0.0 voi pink noise: cot bass cao ~27%, cot treble ~97%
# -> nghieng ~3.6 lan. Voi nhac that, vung giua (bass) gan nhu phang — dung
# nhu screenshot cua ban. Khoi nay giam do nghieng xuong ~1.5 lan
# (do lai voi pink noise: ~50% -> ~80%), khong lam phang hoan toan.
#
# Cach cava ap: moi key phu mot doan cot BANG NHAU theo thu tu thap -> cao,
# tinh rieng tung kenh; khong phu thuoc so cot. Voi dai 40 Hz - 12 kHz:
#   1: 40-70 Hz   2: 70-125   3: 125-220   4: 220-390   5: 390-690
#   6: 0.7-1.2k   7: 1.2-2.2k 8: 2.2-3.9k  9: 3.9-6.8k  10: 6.8-12k
# He so > 1 ap SAU autosens -> track cuc nhieu bass co the cham tran. Thay
# vay thi ha key 1-2 xuong. Xoa ca khoi = ve hanh vi goc cua cava.
1 = 1.8
2 = 1.6
3 = 1.4
4 = 1.25
5 = 1.1
6 = 1.0
7 = 0.95
8 = 0.9
9 = 0.85
10 = 0.8
