## ~/.config/cava/config
## cava 1.0.0 (Arch extra) | Catppuccin Mocha | Samsung Odyssey G5 34" (3440x1440, 21:9, 165 Hz)
##
## Checked against the cava 1.0.0 source (config.c, cava.c, cavacore.c).
## live-config = 1: edit this file -> cava reloads it itself, no restart needed.
## Reload by hand if needed:  pkill -USR1 cava  (whole config)  |  pkill -USR2 cava  (colours only)

[general]

live-config = 1

# Match the G5's refresh rate (165 Hz over DisplayPort). Check the rate actually in use:
#     wlr-randr | grep -i current
# cavacore's smoothing compensates for the framerate itself (framerate_mod = 66 / framerate),
# so a higher fps only makes the motion smoother; it doesn't change how the bars fall and bounce.
# If the terminal can't keep up, drop to 120 — it looks the same, just a little less smooth.
framerate = 165

autosens = 1
sensitivity = 100

# bars = 0 -> fill the terminal's width automatically.
# Do NOT set a fixed bar count: cava 1.0.0 exits outright ("window is too narrow for
# number of bars set") when Wayfire tiles the window narrower, and in a wide window
# it only centres the bars instead of stretching them.
#
# Ultrawide = a great many character columns. The default 2/1 on ~400 columns -> ~130 bars,
# too dense: the bass range has only a few FFT bins, so the lowest bars turn into identical
# steps, and upstream says linear scaling looks best below ~100 bars.
# 3/1 gives ~85-105 bars full screen (depending on the font), ~45 when tiled to half the screen.
#     bars = (tput cols + 1) / 4
bars = 0
bar_width = 3
bar_spacing = 1

# Centred -> the bass bars (the middle of the screen in stereo) sit at the centre of the 1000R curve.
center_align = 1
max_height = 100

# Wider than the default (50 / 10000): the screen is wide enough not to squeeze the mids,
# and 40 Hz shows the low shelf clearly when you add bass for the DT 900 Pro X.
lower_cutoff_freq = 40
higher_cutoff_freq = 12000

# 30 s of silence -> stop the FFT and drawing, only check the input every second. Saves CPU
# at 165 fps. Wakes up within ~1 s at most.
sleep_timer = 30


[input]

# 'auto' = the default sink's monitor. Your default sink is the JM6 (hardware),
# and EasyEffects outputs to it -> cava sees the signal AFTER the EQ.
method = pipewire
source = auto


[output]

method = noncurses
orientation = bottom

# Stereo: bass in the middle, treble out to both edges, mirrored (measured: 60 Hz lights bars
# next to the centre, 8 kHz bars next to the edges). On a curved 21:9 screen the centre is where
# you look — so the [eq] at the end of the file lifts the bass so the middle doesn't go "dead".
channels = stereo
reverse = 0

# Anti-flicker (DEC mode 2026). Terminals without it usually ignore this sequence;
# if you see garbage on screen, set 0.
synchronized_sync = 1

show_idle_bar_heads = 1
xaxis = none

# Try another style on a wide screen: bars grow up and down from the middle line.
; orientation = horizontal


[color]

# Colours live in their own theme file: ~/.config/cava/themes/<name>
#   catppuccin-mocha           the official vertical gradient from catppuccin/cava
#   catppuccin-mocha-spectrum  colour by frequency, mirrored for stereo
# Change the line below -> live-config reloads it.
theme = 'catppuccin-mocha'


[smoothing]

# Monstercat: each bar pulls its neighbours up by a factor of 1.5^distance -> the peaks
# become a soft ridge instead of saw teeth. Values below ~0.7 make the factor < 1 -> wrong; keep it at 1 or above.
monstercat = 1
waves = 0

# 0 = fast/noisy, 100 = slow/smooth. 77 is the upstream default.
noise_reduction = 77


[eq]

# WHY THIS BLOCK EXISTS:
# cava 1.0.0 (linear scaling) multiplies each bar by a factor proportional to frequency.
# Measured on the 1.0.0 binary itself with pink noise: the bass bars reach ~27%, the treble
# bars ~97% -> a ~3.6x tilt. With real music the middle (bass) is almost flat — just
# like your screenshot. This block reduces the tilt to ~1.5x
# (measured again with pink noise: ~50% -> ~80%), without flattening it completely.
#
# How cava applies it: each key covers an EQUAL run of bars, in order low -> high,
# per channel; it doesn't depend on the bar count. With the 40 Hz - 12 kHz range:
#   1: 40-70 Hz   2: 70-125   3: 125-220   4: 220-390   5: 390-690
#   6: 0.7-1.2k   7: 1.2-2.2k 8: 2.2-3.9k  9: 3.9-6.8k  10: 6.8-12k
# Factors > 1 apply AFTER autosens -> very bass-heavy tracks can hit the ceiling. If they
# do, lower keys 1-2. Delete the whole block = back to cava's original behaviour.
1 = 1.8
2 = 1.6
3 = 1.4
4 = 1.25
5 = 1.1
6 = 1.0
7 = 0.95
8 = 0.9
9 = 0.85
10 = 0.8
