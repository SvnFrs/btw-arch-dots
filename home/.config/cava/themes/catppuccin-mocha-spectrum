## Catppuccin Mocha — "spectrum": colour by FREQUENCY instead of by height.
## Horizontal gradient (noncurses only), one colour per bar, mirrored for stereo:
##   left edge (treble) red -> mauve -> blue -> TEAL in the middle (bass) -> blue -> mauve -> red right edge
## Same convention as the vertical theme: teal = low, red = high. On 21:9 the horizontal
## axis is the longest, so a horizontal gradient spreads the colours further than a vertical one.
## 7 colours (max 8); RGB interpolation between the Mocha colours passes through pink/lavender/sapphire.

[color]
horizontal_gradient = 1

horizontal_gradient_color_1 = '#f38ba8'
horizontal_gradient_color_2 = '#cba6f7'
horizontal_gradient_color_3 = '#89b4fa'
horizontal_gradient_color_4 = '#94e2d5'
horizontal_gradient_color_5 = '#89b4fa'
horizontal_gradient_color_6 = '#cba6f7'
horizontal_gradient_color_7 = '#f38ba8'
