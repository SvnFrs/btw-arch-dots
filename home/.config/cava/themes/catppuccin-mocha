## Catppuccin Mocha — vertical gradient, identical to catppuccin/cava themes/mocha-transparent.cava
## No background set: uses the terminal's background (and transparency).
## Bottom -> top: teal, sky, sapphire, blue, mauve, pink, maroon, red.
## autosens keeps the bars from hitting the top often -> most of the time they are teal/blue/mauve,
## and only the peaks of the music reach pink/red.

[color]
gradient = 1

gradient_color_1 = '#94e2d5'
gradient_color_2 = '#89dceb'
gradient_color_3 = '#74c7ec'
gradient_color_4 = '#89b4fa'
gradient_color_5 = '#cba6f7'
gradient_color_6 = '#f5c2e7'
gradient_color_7 = '#eba0ac'
gradient_color_8 = '#f38ba8'
