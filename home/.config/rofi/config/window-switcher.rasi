configuration {
    show-icons:                     true;
    display-window: 		        "";
    window-match-fields:            "all";
    window-format:                  "{w} {c} {t}";
    disable-history:                false;
    click-to-exit: 		            true;
    location:                       0;
}

@import "font.rasi"
@import "catppuccin-mocha.rasi"

window {
    transparency:                   "real";
    background-color:               @base;
    text-color:                     @text;
    border:                         2px;
    border-color:                   @teal;  /* matches the mint tone of the hair */
    border-radius:                  12px;   /* rounded outer frame */
    width:                          850px;
    anchor:                         center;
    x-offset:                       0;
    y-offset:                       0;
}

prompt {
    enabled: 			            true;
    padding: 			            8px;
    background-color: 		        @base;
    text-color: 		            @teal;
}

textbox-prompt-colon {
    expand: 			            false;
    str: 			                "󱂬";    /* a window icon instead of the Arch one, to fit the context */
    border-radius:                  10px;
    background-color:               @surface0;
    text-color:                     @teal;
    padding:                        12px 20px 12px 20px;
    font:			                "JetBrainsMono Nerd Font 14";
}

entry {
    background-color:               @base;
    text-color:                     @text;
    placeholder-color:              @overlay0;
    expand:                         true;
    horizontal-align:               0;
    placeholder:                    "Search opened windows...";
    blink:                          true;
    border:                  	    0px 0px 2px 0px;
    border-color:                   @teal;
    border-radius:                  10px;
    padding:                        15px 8px 10px 8px;
}

inputbar {
	children: 		                [ textbox-prompt-colon, prompt, entry ];
    background-color:               @base;
    text-color:                     @text;
    expand:                         false;
    border:                  	    0px 0px 0px 0px;
    border-radius:                  0px;
    border-color:                   @teal;
    margin:                         0px 0px 10px 0px;
    padding:                        0px;
    position:                       center;
}

case-indicator {
    background-color:               @base;
    text-color:                     @text;
    spacing:                        0;
}

listview {
    background-color:               @base;
    columns:                        1;
    lines:			                6;
    spacing:                        6px;
    cycle:                          false;
    dynamic:                        true;
    layout:                         vertical;
}

mainbox {
    background-color:               @base;
    children:                       [ inputbar, listview ];
    spacing:                        10px;
    padding:                        20px;
}

element {
    background-color:               @base;
    text-color:                     @text;
    orientation:                    horizontal;
    border-radius:                  10px;
    padding:                        8px 12px;
}

element-icon {
    background-color: 	            inherit;
    text-color:       		        inherit;
    horizontal-align:               0.5;
    vertical-align:                 0.5;
    size:                           24px;
    border:                         0px;
}

element-text {
    background-color: 		        inherit;
    text-color:       		        inherit;
    expand:                         true;
    horizontal-align:               0;
    vertical-align:                 0.5;
    margin:                         2px 0px 2px 8px;
}

element normal.urgent,
element alternate.urgent {
    background-color:               @red;
    text-color:                     @crust;
    border-radius:                  10px;
}

/* drop the crude green background from the old version */
element normal.active,
element alternate.active {
    background-color:               @base;
    text-color:                     @teal;
}

/* bring back a soft, elegant highlight colour */
element selected {
    background-color:               @surface1;
    text-color:                     @teal;
    border:                  	    0px 0px 0px 0px;
    border-radius:                  10px;
}

element selected.urgent {
    background-color:               @red;
    text-color:                     @crust;
}

element selected.active {
    background-color:               @surface1;
    text-color:                     @teal;
}