/* GENERATED by scripts/gen-theme.py from theme/templates/rofi/clipboard.rasi.in — edit the template, not this file. */
/* rofi clipboard picker: the FALLBACK for actions.sh `clip` when the Quickshell panel does not
 * answer (docs/clipboard-ui.md). docs/enhalation-desktop.md §4. The chip label is `-p clipboard`.
 * Literal values only (DP4): rofi cannot use @variables in gradients or `highlight`. */
@theme "/dev/null"

configuration {
    font:            "CartographCF Nerd Font, JetBrainsMono Nerd Font 11";
    hover-select:    true;            /* the pill follows the pointer */
    me-select-entry: "";
    me-accept-entry: "MousePrimary";  /* one click copies */
    click-to-exit:   true;
}

* { background-color: transparent; text-color: #cdd6f4; }

window {
    width: 980px;  border: 1px;  border-radius: 26px;  border-color: #45475a8c;
    background-color: transparent;
    background-image: linear-gradient(75deg, #242433f7, #232332f7, #222131f7, #212030f7, #1f1f2ff7, #1e1e2ef7, #1e1e2ef7, #1e1e2ef7, #1e1e2ef7, #1e1e2ef7, #1e1e2ef7, #1e1e2ef7, #1e1e2ef7);   /* DP9: rofi's angle and even stops */
    cursor: default;
}
mainbox {                             /* lit top edge, standing in for inset 0 1px 0 glass-edge */
    padding: 16px;  spacing: 10px;
    border: 1px 0 0 0;  border-radius: 25px;  border-color: #f5e0dc29;
    children: [ "inputbar", "message", "listview" ];
}
inputbar { spacing: 10px; children: [ "chip", "entry" ]; }
chip {                                /* custom box: the warm core */
    orientation: horizontal;  expand: false;  spacing: 8px;
    padding: 12px 16px;  border-radius: 10px;
    background-image: linear-gradient(25deg, #fab387, #f5c2e7);
    children: [ "textbox-glyph", "prompt" ];
}
/* Nerd v3 icons draw past their one-cell advance and rofi clips at the textbox:
   the right padding gives the overflow room (DP9). */
textbox-glyph { str: ""; expand: false; padding: 0 9px 0 0; text-color: #11111b; vertical-align: 0.5; }
prompt        { text-color: #11111b; font: "CartographCF Nerd Font Bold Italic 11"; vertical-align: 0.5; }
entry {
    padding: 12px 16px;  border: 0 0 2px 0;  border-color: #6c7086;  border-radius: 10px;
    background-color: #11111b99;  placeholder: "ssh, https://…";  placeholder-color: #a6adc8;
    cursor: text;  vertical-align: 0.5;
}
message { padding: 10px 14px; border-radius: 10px; background-color: #11111b99; }
textbox { text-color: #a6adc8; }
listview { columns: 1; lines: 12; spacing: 4px; fixed-height: true; cursor: default; scrollbar: true; }
element  { padding: 10px 14px; spacing: 12px; border: 1px 0 0 0; border-radius: 10px;
           border-color: transparent; cursor: pointer; }
element normal.normal, element alternate.normal  { background-color: transparent; text-color: #cdd6f4; }
element selected.normal   { background-color: #cdd6f417; border-color: #f5e0dc1d; text-color: #cdd6f4; }
element normal.urgent, element alternate.urgent  { background-color: #f38ba81f; text-color: #f38ba8; }
element selected.urgent   { background-color: #f38ba81f; border-color: #f5e0dc1d; text-color: #cdd6f4; }
element normal.active, element alternate.active  { text-color: #94e2d5; }
element selected.active   { background-color: #cdd6f417; border-color: #f5e0dc1d; text-color: #94e2d5; }
element-text { text-color: inherit; highlight: bold #cba6f7; vertical-align: 0.5; cursor: inherit; }
/* No per-state font: rofi 2.0 ignores it on rows (§10), so the pill alone marks the selection. */
/* The list is 12 of up to 750 clips: a thumb handle the pointer can find (`thumb`, not
   `line-strong`, which is 2.3:1 on glass). */
scrollbar { handle-width: 4px; handle-color: #9399b2; background-color: transparent; }
