/* rofi clipboard delete picker: the FALLBACK for actions.sh `clip-del` (docs/clipboard-ui.md).
 * docs/enhalation-desktop.md §4.2: the clipboard picker with a DANGER chip instead of the warm core
 * (destructive intent outranks the moment), and the -mesg bar. A full file, not an @import (DP4).
 * Literal values only: rofi cannot use @variables in gradients or `highlight`. */
@theme "/dev/null"

configuration {
    font:            "CartographCF Nerd Font, JetBrainsMono Nerd Font 11";
    hover-select:    true;            /* the pill follows the pointer */
    me-select-entry: "";
    me-accept-entry: "MousePrimary";  /* one click deletes */
    click-to-exit:   true;
}

* { background-color: transparent; text-color: {{ink}}; }

window {
    width: 980px;  border: 1px;  border-radius: 26px;  border-color: {{rim}};
    background-color: transparent;
    background-image: {{rofi-panel-gradient}};   /* DP9: rofi's angle and even stops */
    cursor: default;
}
mainbox {                             /* lit top edge, standing in for inset 0 1px 0 glass-edge */
    padding: 16px;  spacing: 10px;
    border: 1px 0 0 0;  border-radius: 25px;  border-color: {{glass-edge}};
    children: [ "inputbar", "message", "listview" ];
}
inputbar { spacing: 10px; children: [ "chip", "entry" ]; }
chip {                                /* custom box: danger-soft, not the warm core */
    orientation: horizontal;  expand: false;  spacing: 8px;
    padding: 12px 16px;  border-radius: 10px;
    background-image: linear-gradient({{danger-soft}}, {{danger-soft}});
    children: [ "textbox-glyph", "prompt" ];
}
/* Nerd v3 icons draw past their one-cell advance and rofi clips at the textbox:
   the right padding gives the overflow room (DP9). */
textbox-glyph { str: "{{glyph.delete}}"; expand: false; padding: 0 9px 0 0; text-color: {{danger}}; vertical-align: 0.5; }
prompt        { text-color: {{danger}}; font: "CartographCF Nerd Font Bold Italic 11"; vertical-align: 0.5; }
entry {
    padding: 12px 16px;  border: 0 0 2px 0;  border-color: {{line-strong}};  border-radius: 10px;
    background-color: {{well}};  placeholder: "ssh, https://…";  placeholder-color: {{ink-muted}};
    cursor: text;  vertical-align: 0.5;
}
message { padding: 10px 14px; border-radius: 10px; background-color: {{well}}; }
textbox { text-color: {{ink-muted}}; }
listview { columns: 1; lines: 12; spacing: 4px; fixed-height: true; cursor: default; scrollbar: true; }
element  { padding: 10px 14px; spacing: 12px; border: 1px 0 0 0; border-radius: 10px;
           border-color: transparent; cursor: pointer; }
element normal.normal, element alternate.normal  { background-color: transparent; text-color: {{ink}}; }
element selected.normal   { background-color: {{pill}}; border-color: {{pill-top}}; text-color: {{ink}}; }
element normal.urgent, element alternate.urgent  { background-color: {{danger-soft}}; text-color: {{danger}}; }
element selected.urgent   { background-color: {{danger-soft}}; border-color: {{pill-top}}; text-color: {{ink}}; }
element normal.active, element alternate.active  { text-color: {{spark}}; }
element selected.active   { background-color: {{pill}}; border-color: {{pill-top}}; text-color: {{spark}}; }
element-text { text-color: inherit; highlight: bold {{accent}}; vertical-align: 0.5; cursor: inherit; }
/* No per-state font: rofi 2.0 ignores it on rows (§10), so the pill alone marks the selection. */
/* The list is 12 of up to 750 clips: a thumb handle the pointer can find (`thumb`, not
   `line-strong`, which is 2.3:1 on glass). */
scrollbar { handle-width: 4px; handle-color: {{thumb}}; background-color: transparent; }
