/* swaync — Enhalation (Mocha), desktop profile. docs/enhalation-desktop.md §5.
 *
 * swaync 0.12.6 loads /etc/xdg/swaync/style.css first and this file on top, at the
 * same priority (src/functions.vala). So: override the default's custom properties
 * first (S1), and style nodes only where those fall short. Node and class names are
 * the installed default's (S2, S5).
 *
 * I3 scope: the control centre. Floating notifications keep swaync's default look
 * until I4, so every card rule below is scoped to .control-center.
 */

/* ── S1: the default's custom properties ─────────────────────────────────── */
:root {
  --cc-bg: transparent;                 /* .control-center paints its own glass */
  --noti-border-color: transparent;
  --noti-bg-darker: {{well}};           /* inline-reply entry: a well */
  --noti-bg-hover: {{pill}};
  --noti-bg-focus: transparent;         /* focus fills the card, never the row (§3.4) */
  --noti-close-bg: {{pill}};
  --noti-close-bg-hover: {{pill-hover}};
  --text-color: {{ink}};
  --text-color-disabled: {{ink-muted}};
  --bg-selected: {{accent}};
  --border-radius: 14px;                /* 26 − 12: panel radius minus its padding */
  --notification-shadow: none;
  --font-size-body: 14px;
  --font-size-summary: 14px;
  /* The default's rules read the misspelt name; --hover-transition only aliases it. */
  --hover-tranistion: background-color {{dur-hover}} {{ease-out-expo}};
  --mpris-album-art-overlay: {{art-scrim}};   /* S7 */
  --mpris-button-hover: {{pill-hover}};
  --mpris-album-art-shadow: none;
}

/* ── windows (S2) and type ───────────────────────────────────────────────── */
notificationwindow, blankwindow, .blank-window, .floating-notifications,
.control-center .control-center-list {
  background: transparent;
}

* {
  font-family: "CartographCF Nerd Font", "JetBrainsMono Nerd Font", monospace;
  font-size: 14px;
}

/* ── the panel: glass, sheen, grain, rim, lit top edge, float shadow ─────── */
.control-center {
  background-color: transparent;
  background-image: linear-gradient(165deg, {{tint}}, {{tint-end}} 42%), url("assets/glass-grain.png");
  background-repeat: no-repeat, repeat;
  background-size: auto, 220px 220px;
  border: none;
  border-radius: 26px;
  padding: 12px;
  color: {{ink}};
  box-shadow: {{glass-float}}, inset 0 1px 0 {{glass-edge}}, inset 0 0 0 1px {{rim}};
}

/* Enter (DP7). Only the control-centre window gets .open, on every show (S4:
   controlCenter.vala), so this replays each time; the click-catcher BlankWindow
   shares the class blank-window but never gets .open and holds no .control-center. */
@keyframes enh-panel-in {
  from { opacity: 0; transform: translateY(-6px) scale(0.97); }
  to   { opacity: 1; transform: none; }
}
.blank-window.open .control-center {
  animation: enh-panel-in {{dur-enter}} {{ease-out-expo}} both;
}

.control-center .widget {
  margin: 0 0 8px 0;
}

.control-center .control-center-list-placeholder {
  opacity: 1;
  color: {{ink-muted}};
}

/* ── title + Clear all ───────────────────────────────────────────────────── */
.widget-title {
  margin: 0;
  padding: 8px 8px 12px 10px;
}
.widget-title > label {
  font-size: 20px;
  font-weight: 600;
  color: {{ink}};
}
.widget-title > button,
.widget-mpris > box > button,
.widget-mpris .widget-mpris-player .mpris-overlay > box > button {
  background: {{pill}};
  border: none;
  border-radius: 9999px;
  box-shadow: inset 0 1px 0 {{pill-top}};
  color: {{ink}};
  transition: background-color {{dur-hover}} {{ease-out-expo}}, transform {{dur-press}} {{ease-press}};
}
.widget-title > button {
  padding: 8px 14px;
  font-size: 13px;
}
.widget-title > button:hover,
.widget-mpris > box > button:hover,
.widget-mpris .widget-mpris-player .mpris-overlay > box > button:hover {
  background: {{pill-hover}};
}
.widget-title > button:active,
.widget-mpris > box > button:active,
.widget-mpris .widget-mpris-player .mpris-overlay > box > button:active {
  transform: scale(0.972);
  box-shadow: inset 0 1px 3px {{well}};
}

/* ── cells: DND and volume (14 = 26 − 12) ────────────────────────────────── */
.widget-dnd, .widget-volume {
  background: {{cell}};
  border-radius: 14px;
  box-shadow: inset 0 1px 0 {{cell-top}};
  padding: 12px 14px;
}
.widget-dnd > label {
  font-size: 14px;
  color: {{ink}};
}

/* DND switch: a well when off, the warm core when on (the only warm core in swaync). */
.widget-dnd > switch {
  min-width: 56px;
  min-height: 32px;
  border-radius: 9999px;
  border: none;
  background: {{well}};
  box-shadow: {{well-shadow}};
  transition: box-shadow {{dur-slide}} {{ease-out-expo}};
}
.widget-dnd > switch:checked {
  background-color: transparent;
  background-image: url("assets/switch-on.png");
  background-size: 100% 100%;
  box-shadow: {{halo-glow}};
}
.widget-dnd > switch > slider {
  min-width: 22px;
  min-height: 22px;
  margin: 5px;
  border: none;
  border-radius: 9999px;
  background-image: radial-gradient(circle at 35% 30%, {{thumb-hi}}, {{thumb}} 70%);
  box-shadow: 0 2px 6px {{thumb-shadow}};
  transition: min-width {{dur-press}} {{ease-press}};
}
.widget-dnd > switch:checked > slider {
  background-image: radial-gradient(circle at 35% 30%, {{on-halo-hi}}, {{on-halo}} 75%);
}
.widget-dnd > switch:active > slider {
  min-width: 28px;                      /* press squash */
}

/* Volume: a well trough, accent fill, the same knob. margin −4px on an 18px knob
   keeps 18 − 8 = 10 ≥ 0 (GTK 4 rejects negative sizes). */
.widget-volume label {
  color: {{ink-muted}};
}
.widget-volume scale trough {
  min-height: 10px;
  border-radius: 9999px;
  background: {{well}};
  box-shadow: {{well-shadow}};
}
.widget-volume scale trough highlight {
  background: {{accent}};
  border-radius: 9999px;
}
.widget-volume scale slider {
  min-width: 18px;
  min-height: 18px;
  margin: -4px;
  border: none;
  border-radius: 9999px;
  background-image: radial-gradient(circle at 35% 30%, {{thumb-hi}}, {{thumb}} 70%);
  box-shadow: 0 2px 6px {{thumb-shadow}};
}

/* ── mpris (S7): blurred art stays, art-scrim over it, ink-only glass buttons ─ */
.widget-mpris {
  background: transparent;
  padding: 0;
}
.widget-mpris .widget-mpris-player {
  margin: 0;
  border-radius: 14px;
  box-shadow: none;
}
.widget-mpris .widget-mpris-player .mpris-overlay {
  padding: 12px 14px;
  border-radius: 14px;
  background-color: {{art-scrim}};
}
.widget-mpris .widget-mpris-player .mpris-overlay .widget-mpris-album-art {
  border-radius: 12px;
  box-shadow: none;
}
.widget-mpris .widget-mpris-player .mpris-overlay .widget-mpris-title {
  font-size: 14px;
  font-weight: 600;
  color: {{ink}};
}
.widget-mpris .widget-mpris-player .mpris-overlay .widget-mpris-subtitle {
  font-size: 12px;
  color: {{ink-muted}};
}
.widget-mpris > box > button,
.widget-mpris .widget-mpris-player .mpris-overlay > box > button {
  min-width: 34px;
  min-height: 34px;
  padding: 0;
}

/* ── notifications in the centre: cards are cells; hover/focus REPLACE the fill ─ */
.control-center .notification-row,
.control-center .notification-row:focus {
  background: transparent;
}
.control-center .notification-row .notification-background {
  padding: 0 0 8px 0;
}
.control-center .notification-row .notification-background .notification {
  background: {{cell}};
  border: none;
  border-radius: 14px;
  box-shadow: inset 0 1px 0 {{cell-top}};
  transition: background-color {{dur-hover}} {{ease-out-expo}};
}
.control-center .notification-row:hover .notification-background .notification,
.control-center .notification-row:focus .notification-background .notification {
  background: {{pill}};
}
/* The inner action must not add a second pill on top (§3.4). */
.control-center .notification-row .notification-background .notification .notification-default-action,
.control-center .notification-row .notification-background .notification .notification-default-action:hover,
.control-center .notification-row .notification-background .notification .notification-action:hover {
  background: transparent;
}

/* Critical (S5: the class sits on .notification). danger-soft REPLACES the fill,
   hovered or not; the summary stays ink. */
.control-center .notification-row .notification-background .notification.critical,
.control-center .notification-row:hover .notification-background .notification.critical {
  background: {{danger-soft}};
  box-shadow: inset 0 0 0 1px {{danger-rim}};
}

.control-center .notification .summary {
  font-size: 14px;
  font-weight: 600;
  color: {{ink}};
}
.control-center .notification .body {
  font-size: 14px;
  font-weight: 400;
  color: {{ink-muted}};
}
.control-center .notification .time {
  font-size: 12px;
  font-weight: 400;
  color: {{ink-muted}};
}

/* Close: a 24px glass circle that appears on hover. */
.control-center .close-button {
  min-width: 24px;
  min-height: 24px;
  border-radius: 9999px;
  background: {{pill}};
  box-shadow: inset 0 1px 0 {{pill-top}};
  color: {{ink}};
  opacity: 0;
  transition: opacity {{dur-hover}} {{ease-out-expo}}, background-color {{dur-hover}} {{ease-out-expo}};
}
.control-center .notification-row:hover .close-button,
.control-center .notification-group:hover .notification-group-close-button .close-button,
.control-center .close-button:focus-visible {
  opacity: 1;
}
.control-center .close-button:hover {
  background: {{pill-hover}};
}

/* ── notification groups (S6): the container has no fill; only cards carry the cell.
   A critical group adds nothing to its container. ───────────────────────────── */
.control-center .notification-group,
.control-center .notification-group:focus,
.control-center .notification-group.critical {
  background: transparent;
}
.control-center .notification-group .notification-group-headers .notification-group-header,
.control-center .notification-group .notification-group-headers .notification-group-icon {
  color: {{ink-muted}};
  font-size: 12px;
}
.control-center .notification-group.collapsed .notification-row .notification {
  background-color: {{cell}};
}
.control-center .notification-group.collapsed:hover .notification-row:not(:only-child) .notification {
  background-color: {{pill}};
}

/* Keyboard focus (DP8: accent = focus). */
.control-center button:focus-visible,
.control-center switch:focus-visible {
  outline: 2px solid {{accent}};
  outline-offset: 2px;
}
